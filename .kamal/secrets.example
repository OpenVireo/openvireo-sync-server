# Copy to .kamal/secrets (not in git) and fill in. Kamal reads it as dotenv, $(...) works.

# DigitalOcean Container Registry, from: doctl registry docker-config --read-write
KAMAL_REGISTRY_USERNAME=
KAMAL_REGISTRY_PASSWORD=

# The openvireo_sync database and user in the openvireo-pg cluster, over the VPC (private host).
SYNC_DATABASE_URL=postgresql://openvireo_sync:<password>@private-<host>.db.ondigitalocean.com:25060/openvireo_sync?sslmode=require

# The Spaces key that can only read and write the openvireo-sync bucket.
SYNC_S3_ACCESS_KEY=
SYNC_S3_SECRET_KEY=

# The same value as the account server's SYNC_INTERNAL_TOKEN.
SYNC_INTERNAL_TOKEN=
